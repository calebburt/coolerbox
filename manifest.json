{
  "manifest_version": 3,
  "name": "DCC Utils",
  "version": "0.0.1",
  "description": "Adds various improvements for websites used by DCC.",
  "content_scripts": [
    {
        "js": ["scripts/coolerbox.js"],
        "matches": [
            "*://schoolbox.donvale.vic.edu.au/*"
        ]
    },
    {
        "js": ["scripts/shared.js", "scripts/coolerbox_themes.js"],
        "matches": [
            "*://schoolbox.donvale.vic.edu.au/*"
        ],
        "run_at": "document_end"
    },
    {
        "js": ["scripts/shared.js", "scripts/coolerteams.js"],
        "matches": [
            "*://teams.cloud.microsoft/*"
        ],
        "run_at": "document_end"
    },
    {
        "js": ["scripts/shared.js", "scripts/coolerteams_themes.js"],
        "matches": [
            "*://teams.cloud.microsoft/*"
        ],
        "run_at": "document_end"
    }
  ]
}